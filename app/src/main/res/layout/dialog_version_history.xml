<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/normal_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/normal_margin">

    <ImageView
        android:id="@+id/version_history_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/medium_margin"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/version_history_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/normal_margin"
        android:alpha="0.75"
        android:gravity="center"
        android:text="@string/app_tagline"
        android:textSize="@dimen/normal_text_size" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/version_history_current_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="bold"
        tools:text="v1.0.3 b20260915_1239" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/normal_margin"
        android:alpha="0.2"
        android:background="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin"
        android:maxHeight="380dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/version_history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
